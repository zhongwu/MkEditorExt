{
  "name": "mk-editor-ext",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.7",
  "publisher": "zhongwu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhongwu/MkEditorExt.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "icon": "images/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "editor",
    "live preview",
    "wysiwyg",
    "mermaid",
    "katex",
    "math",
    "table",
    "obsidian",
    "export pdf"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdEditor.editor",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mdEditor.openEditor",
        "title": "%command.openEditor.title%",
        "category": "%command.category%"
      },
      {
        "command": "mdEditor.setMode",
        "title": "%command.setMode.title%",
        "category": "%command.category%"
      },
      {
        "command": "mdEditor.toggleSource",
        "title": "%command.toggleSource.title%",
        "category": "%command.category%"
      },
      {
        "command": "mdEditor.goToHeading",
        "title": "%command.goToHeading.title%",
        "category": "%command.category%"
      },
      {
        "command": "mdEditor.insertImage",
        "title": "%command.insertImage.title%",
        "category": "%command.category%"
      },
      {
        "command": "mdEditor.exportHtml",
        "title": "%command.exportHtml.title%",
        "category": "%command.category%"
      },
      {
        "command": "mdEditor.exportPdf",
        "title": "%command.exportPdf.title%",
        "category": "%command.category%"
      }
    ],
    "keybindings": [
      {
        "command": "mdEditor.toggleSource",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "activeCustomEditorId == 'mdEditor.editor'"
      },
      {
        "command": "mdEditor.goToHeading",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeCustomEditorId == 'mdEditor.editor'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mdEditor.openEditor",
          "when": "resourceExtname == .md || resourceExtname == .markdown"
        }
      ],
      "explorer/context": [
        {
          "command": "mdEditor.openEditor",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "mdEditor.defaultMode": {
          "type": "string",
          "enum": [
            "live",
            "source",
            "reading"
          ],
          "default": "live",
          "markdownDescription": "%config.defaultMode.description%"
        },
        "mdEditor.proseFontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.proseFontFamily.description%"
        },
        "mdEditor.browserPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "%config.browserPath.description%"
        },
        "mdEditor.customCss": {
          "type": "string",
          "default": "",
          "scope": "application",
          "editPresentation": "multilineText",
          "markdownDescription": "%config.customCss.description%"
        },
        "mdEditor.renderHtml": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.renderHtml.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node esbuild.mjs --tests && vscode-test",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.11",
    "@lezer/markdown": "^1.8.1",
    "@types/katex": "^0.16.8",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "@types/vscode": "~1.74.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.2.0",
    "prettier": "^3.9.10",
    "sanitize-html": "^2.18.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "l10n": "./l10n"
}
