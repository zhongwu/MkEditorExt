{
  "name": "mk-editor-ext",
  "displayName": "Markdown Live Editor",
  "description": "Live-preview Markdown editor that never rewrites parts of the file you didn't touch.",
  "version": "0.0.1",
  "publisher": "zhongwu",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/zhongwu/MkEditorExt.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "editor",
    "live preview",
    "wysiwyg"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdEditor.editor",
        "displayName": "Markdown Live Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mdEditor.openEditor",
        "title": "Open in Markdown Live Editor",
        "category": "Markdown Live Editor"
      },
      {
        "command": "mdEditor.setMode",
        "title": "Switch Mode (Live / Source / Reading)",
        "category": "Markdown Live Editor"
      },
      {
        "command": "mdEditor.toggleSource",
        "title": "Toggle Source Mode",
        "category": "Markdown Live Editor"
      },
      {
        "command": "mdEditor.goToHeading",
        "title": "Go to Heading",
        "category": "Markdown Live Editor"
      },
      {
        "command": "mdEditor.insertImage",
        "title": "Insert Image",
        "category": "Markdown Live Editor"
      },
      {
        "command": "mdEditor.exportHtml",
        "title": "Export to HTML",
        "category": "Markdown Live Editor"
      },
      {
        "command": "mdEditor.exportPdf",
        "title": "Export to PDF",
        "category": "Markdown Live Editor"
      }
    ],
    "keybindings": [
      {
        "command": "mdEditor.toggleSource",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "activeCustomEditorId == 'mdEditor.editor'"
      },
      {
        "command": "mdEditor.goToHeading",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeCustomEditorId == 'mdEditor.editor'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mdEditor.openEditor",
          "when": "resourceExtname == .md || resourceExtname == .markdown"
        }
      ],
      "explorer/context": [
        {
          "command": "mdEditor.openEditor",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Live Editor",
      "properties": {
        "mdEditor.defaultMode": {
          "type": "string",
          "enum": [
            "live",
            "source",
            "reading"
          ],
          "default": "live",
          "markdownDescription": "How a Markdown file is shown when you open it. The mode you last picked in this workspace is used instead, once you have picked one."
        },
        "mdEditor.proseFontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "Font for text in the editor (CSS `font-family`). Leave empty to use VS Code's UI font. Code always uses `#editor.fontFamily#`."
        },
        "mdEditor.browserPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Program file of Google Chrome, Microsoft Edge or Chromium, used by **Export to PDF**. Leave empty to look in the usual places. It can only be set in your user settings."
        },
        "mdEditor.customCss": {
          "type": "string",
          "default": "",
          "scope": "application",
          "editPresentation": "multilineText",
          "markdownDescription": "Your own CSS for the editor, for example `.cm-md-h1 { color: orange; }`. It can only be set in your user settings, not in a workspace, so a project cannot restyle your editor."
        },
        "mdEditor.renderHtml": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Draw raw HTML blocks in Markdown files (after removing scripts, styles, forms and links that navigate). When off, HTML blocks are shown as source."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node esbuild.mjs --tests && vscode-test",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.11",
    "@lezer/markdown": "^1.8.1",
    "@types/katex": "^0.16.8",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "@types/vscode": "~1.74.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.2.0",
    "prettier": "^3.9.10",
    "sanitize-html": "^2.18.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
