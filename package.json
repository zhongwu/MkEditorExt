{
  "name": "mk-editor-ext",
  "displayName": "Markdown Live Editor",
  "description": "Live-preview Markdown editor that never rewrites parts of the file you didn't touch.",
  "version": "0.0.1",
  "publisher": "zhongwu",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/zhongwu/MkEditorExt.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "editor",
    "live preview",
    "wysiwyg"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdEditor.editor",
        "displayName": "Markdown Live Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mdEditor.openEditor",
        "title": "Open in Markdown Live Editor",
        "category": "Markdown Live Editor"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mdEditor.openEditor",
          "when": "resourceExtname == .md || resourceExtname == .markdown"
        }
      ],
      "explorer/context": [
        {
          "command": "mdEditor.openEditor",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node esbuild.mjs --tests && vscode-test",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/vscode": "~1.74.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
